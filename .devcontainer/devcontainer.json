{
  "name": "audio-tools",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-24-bookworm",
  "runArgs": ["-p", "5173:5173"],
  "features": {
    "ghcr.io/devcontainers-contrib/features/pnpm:2": {
      "version": "11.21.0"
    }
  },
  "postCreateCommand": "pnpm install",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "bradlc.vscode-tailwindcss"]
    }
  },
  "remoteUser": "node"
}
